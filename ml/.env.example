# Reference of env vars consumed by the ML service.
# This file is NOT copied into the container — pass values explicitly via
# `docker run -e VAR=value ...` or via the `environment:` block in
# docker-compose.yml (which expands ${VAR} from the host shell or from a
# .env file located next to the compose file).

# Photo source: backend (default) or s3
PHOTO_SOURCE=backend

# Required when PHOTO_SOURCE=backend
BACKEND_BASE_URL=http://backend:8000
BACKEND_TIMEOUT=30.0
# ML service credentials for backend login (POST /api/v1/auth/login).
# Required when PHOTO_SOURCE=backend.
BACKEND_EMAIL=
BACKEND_PASSWORD=

# Required when PHOTO_SOURCE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Local MinIO: http://localhost:9000  |  AWS: leave blank
S3_ENDPOINT_URL=

CLIP_MODEL_NAME=ViT-B/32
LOG_LEVEL=INFO
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
