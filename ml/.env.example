# Photo source: backend (default) or s3
PHOTO_SOURCE=backend

# Required when PHOTO_SOURCE=backend
BACKEND_BASE_URL=http://backend:8000
BACKEND_TIMEOUT=30.0
# Fallback Bearer token used when /process request has no Authorization header.
# Always sent if set, even when the request itself carries no token.
BACKEND_AUTH_TOKEN=

# Required when PHOTO_SOURCE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Local MinIO: http://localhost:9000  |  AWS: leave blank
S3_ENDPOINT_URL=

CLIP_MODEL_NAME=ViT-B/32
LOG_LEVEL=INFO
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
